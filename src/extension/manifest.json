{
  "manifest_version": 3,
  "name": "Context Awareness",
  "version": "0.1.0",
  "description": "A local browser context observer.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_title": "Capture current page context"
  },
  "background": {
    "service_worker": "background.js"
  }
}
